---
import Base from "../layouts/Base.astro";
import { nav } from "../data/site";
---
<Base title="Page not found | Arrow Turf" description="That page has moved or no longer exists." noindex>
  <section class="nf">
    <canvas class="nf__grass" data-grass aria-hidden="true"></canvas>
    <div class="wrap">
      <p class="eyebrow">Page not found</p>
      <h1>This patch hasn’t been laid yet</h1>
      <p class="lead">The page you’re after has moved or doesn’t exist. Try one of these instead:</p>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .nf { position: relative; min-height: 80vh; padding: calc(var(--header-h) + 6rem) 0 12rem; background: var(--color-paddock); color: white; overflow: hidden; }
  .nf__grass { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 200px; }
  .nf h1 { color: white; max-width: 14ch; }
  .nf .eyebrow { color: var(--color-clover); }
  .nf .lead { color: rgba(255,255,255,.8); margin: 1.5rem 0; }
  .nf ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .nf a { display: inline-block; padding: .55rem 1rem; border-radius: 999px; background: rgba(255,255,255,.08); text-decoration: none; }
  .nf a:hover { background: var(--color-clover); color: var(--color-paddock); }
</style>
