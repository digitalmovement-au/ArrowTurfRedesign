---
/** Image that "unrolls" into place like a turf roll being laid. */
import { img } from "../data/site";
interface Props { src: string; alt: string; class?: string; eager?: boolean; sizes?: string; ratio?: string }
const { src, alt, class: cls = "", eager = false, ratio } = Astro.props;
---
<div class={`roll ${cls}`} data-roll style={ratio ? `aspect-ratio:${ratio}` : undefined}>
  <img src={img(src)} alt={alt} loading={eager ? "eager" : "lazy"} decoding="async" fetchpriority={eager ? "high" : "auto"} />
  <span class="roll__cyl" aria-hidden="true"></span>
</div>
