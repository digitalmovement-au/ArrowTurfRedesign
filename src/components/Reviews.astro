---
import { reviews } from "../data/site";
import Icon from "./Icon.astro";
---
<section class="section rev on-dark section--dark" aria-labelledby="rev-title">
  <div class="wrap">
    <div class="rev__head">
      <p class="eyebrow">Google reviews</p>
      <h2 id="rev-title">What Sydney customers say after the truck leaves</h2>
    </div>
  </div>
  <div class="rev__track" data-marquee>
    <ul class="rev__row">
      {[...reviews, ...reviews].map((r, i) => (
        <li class="rev__card" aria-hidden={i >= reviews.length ? "true" : undefined}>
          <span class="rev__stars" role="img" aria-label="5 out of 5 stars">{[1,2,3,4,5].map(() => <Icon name="star" size={18} />)}</span>
          <blockquote>{r.text}</blockquote>
          <p class="rev__name">{r.name}<span>Posted on Google</span></p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .rev { overflow: hidden; }
  .rev__head { max-width: 44rem; margin: 0 auto 3rem; text-align: center; }
  .rev__track { overflow: hidden; mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent); }
  .rev__row { list-style: none; margin: 0; padding: 0 var(--gutter); display: flex; gap: 1rem; width: max-content; animation: rev-slide 60s linear infinite; }
  .rev__track:hover .rev__row, .rev__track:focus-within .rev__row { animation-play-state: paused; }
  .rev__card { width: min(80vw, 400px); padding: 1.75rem; border-radius: var(--radius-lg); background: rgba(255,255,255,.06); display: flex; flex-direction: column; gap: 1rem; }
  .rev__stars { display: inline-flex; gap: 2px; color: var(--color-clover); }
  .rev__card blockquote { margin: 0; color: rgba(255,255,255,.88); font-size: 1.02rem; flex: 1; }
  .rev__name { font-weight: 650; color: white; display: grid; }
  .rev__name span { font-weight: 400; font-size: .85rem; color: rgba(255,255,255,.55); }
  @keyframes rev-slide { to { transform: translateX(-50%); } }
  /* Mobile: no marquee — show every review stacked, each at its natural height */
  @media (max-width: 720px) {
    .rev__track { mask-image: none; -webkit-mask-image: none; }
    .rev__row { animation: none; flex-direction: column; width: auto; padding: 0 var(--gutter); }
    .rev__card { width: 100%; }
    .rev__card[aria-hidden] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .rev__row { animation: none; flex-wrap: wrap; width: auto; } .rev__card[aria-hidden] { display: none; } }
</style>
