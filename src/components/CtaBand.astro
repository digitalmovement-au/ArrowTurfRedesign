---
import { business } from "../data/site";
import QuoteForm from "./QuoteForm.astro";
import Icon from "./Icon.astro";
import GrassEdge from "./GrassEdge.astro";
---
<section class="cta on-dark" id="quote-bottom" aria-labelledby="cta-title">
  <GrassEdge seed={23} />
  <div class="wrap cta__in">
    <div>
      <p class="eyebrow">Get in touch with Arrow Turf</p>
      <h2 id="cta-title">Contact us for a free quote</h2>
      <ul class="cta__list">
        <li><Icon name="phone" /><div><span>Phone</span><a href={business.phoneHref}>{business.phone}</a></div></li>
        <li><Icon name="mail" /><div><span>Email</span><a href={`mailto:${business.email}`}>{business.email}</a></div></li>
        <li><Icon name="pin" /><div><span>The farm</span><a href={business.mapUrl} target="_blank" rel="noopener">{business.address}</a></div></li>
      </ul>
    </div>
    <QuoteForm id="bottom-quote" title="Tell us about your lawn" />
  </div>
</section>
<style>
  .cta { position: relative; background: var(--color-leaf); color: white; padding-block: clamp(4.5rem, 9vw, 7rem); }
  .cta h2 { color: white; font-size: clamp(2.4rem, 5vw, 4.2rem); max-width: 12ch; }
  .cta .eyebrow { color: var(--color-clover); }
  .cta__in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .cta__list { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; gap: 1.25rem; }
  .cta__list li { display: flex; gap: 1rem; align-items: flex-start; }
  .cta__list :global(svg) { flex: none; color: var(--color-clover); margin-top: .2rem; }
  .cta__list span { display: block; font-size: .85rem; color: rgba(255,255,255,.7); }
  .cta__list a { font-weight: 650; font-size: 1.15rem; text-decoration: none; }
  .cta__list a:hover { color: var(--color-clover); }
  @media (max-width: 900px) { .cta__in { grid-template-columns: 1fr; } }
</style>
