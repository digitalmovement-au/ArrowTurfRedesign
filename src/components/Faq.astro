---
import { md } from "../lib/md";
import type { Faq as F } from "../data/faqs";
import Icon from "./Icon.astro";
interface Props { faqs: F[]; eyebrow?: string; heading?: string }
const { faqs, eyebrow = "Frequently asked questions", heading = "Good to know" } = Astro.props;
const initial = 8;
---
<section class="section faq" aria-labelledby="faq-title">
  <div class="wrap faq__in">
    <div class="faq__head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="faq-title">{heading}</h2>
      <p class="faq__sub">Can’t find your answer? Call the farm on <a href="tel:0490779707">0490 779 707</a> — you’ll talk to the people who grow your turf.</p>
    </div>
    <div class="faq__list" data-faq>
      {faqs.map((f, i) => (
        <details class="faq__item" hidden={i >= initial ? true : undefined} data-more={i >= initial ? "" : undefined}>
          <summary><span>{f.q}</span><Icon name="plus" class="faq__ico" /></summary>
          <div class="faq__a prose" set:html={md(f.a)} />
        </details>
      ))}
      {faqs.length > initial && <button type="button" class="btn btn--ghost faq__all" data-faq-all>Show all {faqs.length} questions</button>}
    </div>
  </div>
</section>
<style>
  .faq__in { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .faq__head { position: sticky; top: calc(var(--header-h) + 2rem); }
  .faq__sub { margin-top: 1.25rem; color: var(--color-ink-soft); max-width: 32ch; }
  .faq__sub a { color: var(--color-leaf); font-weight: 600; text-decoration: none; white-space: nowrap; }
  .faq__item { border-bottom: 1px solid color-mix(in srgb, var(--color-paddock) 14%, transparent); }
  .faq__item:first-child { border-top: 1px solid color-mix(in srgb, var(--color-paddock) 14%, transparent); }
  .faq__item summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding: 1.3rem 0; cursor: pointer; font-weight: 600; font-size: 1.08rem; color: var(--color-paddock); }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: var(--color-leaf); }
  :global(.faq__ico) { flex: none; transition: transform .35s var(--ease-turf); color: var(--color-leaf); }
  .faq__item[open] :global(.faq__ico) { transform: rotate(45deg); }
  .faq__a { padding: 0 0 1.4rem; }
  .faq__all { margin-top: 1.5rem; color: var(--color-paddock); }
  @media (max-width: 900px) { .faq__in { grid-template-columns: 1fr; } .faq__head { position: relative; top: 0; } }
</style>
