---
import { img, business } from "../data/site";
import QuoteForm from "./QuoteForm.astro";
import Icon from "./Icon.astro";
interface Props {
  eyebrow?: string; h1: string; lead: string; image?: string; home?: boolean;
  breadcrumb?: { name: string; path: string }[];
}
const { eyebrow, h1, lead, image, home = false, breadcrumb } = Astro.props;
---
<section class:list={["hero", home && "hero--home"]} id="quote" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    {image && <img src={img(image)} alt="" fetchpriority="high" decoding="async" data-hero-img />}
  </div>
  <canvas class="hero__grass" data-grass aria-hidden="true"></canvas>

  <div class="wrap hero__in">
    <div class="hero__copy">
      {breadcrumb && (
        <nav aria-label="Breadcrumb" class="crumbs">
          <ol>
            <li><a href="/">Home</a></li>
            {breadcrumb.map((b, i) => <li>{i === breadcrumb.length - 1 ? <span aria-current="page">{b.name}</span> : <a href={b.path}>{b.name}</a>}</li>)}
          </ol>
        </nav>
      )}
      {eyebrow && <p class="eyebrow hero__eyebrow">{eyebrow}</p>}
      <h1 id="hero-title" class="hero__h1" data-hero-title>{h1}</h1>
      <p class="hero__lead">{lead}</p>
      <div class="hero__actions">
        <a class="btn btn--clover" href={business.phoneHref} data-magnetic><Icon name="phone" />{business.phone}</a>
        {home ? <a class="btn btn--ghost" href="#projects">See our work</a> : <a class="btn btn--ghost" href="/contact/">Contact us</a>}
      </div>
    </div>
    <div class="hero__form">
      <QuoteForm id="hero-quote" />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; color: white; background: var(--color-paddock); padding: calc(var(--header-h) + clamp(2.5rem, 6vw, 5rem)) 0 clamp(6rem, 12vw, 9rem); overflow: hidden; isolation: isolate; }
  .hero--home { min-height: min(100svh, 980px); display: flex; align-items: center; }
  .hero__bg { position: absolute; inset: 0; z-index: -2; }
  .hero__bg img { width: 100%; height: 118%; object-fit: cover; object-position: center 60%; }
  .hero__bg::after { content: ""; position: absolute; inset: 0; background:
    linear-gradient(90deg, rgba(16,36,23,.92) 0%, rgba(16,36,23,.72) 42%, rgba(16,36,23,.25) 75%, rgba(16,36,23,.35) 100%),
    linear-gradient(0deg, rgba(22,48,31,1) 0%, rgba(22,48,31,0) 30%); }
  .hero__grass { position: absolute; left: 0; right: 0; bottom: -2px; width: 100%; height: clamp(120px, 22vh, 230px); z-index: -1; pointer-events: none; }
  .hero__in { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; width: 100%; }
  .hero__h1 { color: white; max-width: 13ch; }
  .hero--home .hero__h1 { font-size: clamp(2.8rem, 7vw, 6.2rem); }
  .hero__eyebrow { color: var(--color-clover); }
  .hero__lead { margin-top: 1.5rem; font-size: clamp(1.05rem, 1.4vw, 1.22rem); color: rgba(255,255,255,.82); max-width: 34em; }
  .hero__actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 2rem; }
  .hero__actions .btn--ghost { color: white; }
  .hero__form { position: relative; z-index: 2; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; padding: 0; margin: 0 0 1.5rem; font-size: .9rem; color: rgba(255,255,255,.6); }
  .crumbs li + li::before { content: "/"; margin-right: .4rem; opacity: .5; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--color-clover); }
  .crumbs [aria-current] { color: rgba(255,255,255,.9); }
  @media (max-width: 960px) {
    .hero__in { grid-template-columns: 1fr; }
    .hero__h1 { max-width: 16ch; }
    .hero__bg::after { background: linear-gradient(180deg, rgba(16,36,23,.55), rgba(16,36,23,.88) 55%, rgba(22,48,31,1)); }
  }
</style>
