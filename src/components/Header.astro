---
import { nav, business, img } from "../data/site";
import Icon from "./Icon.astro";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = (Astro.url.pathname.slice(baseUrl.length) || "/").replace(/\/?$/, "/");
const active = (href: string) => {
  const h = href.replace(/\/?$/, "/");
  return h === "/" ? path === "/" : path.startsWith(h);
};
---
<header class="hdr" data-header>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label="Arrow Turf home">
      <img src={img("2024/09/cropped-logo.png")} alt="Arrow Turf" width="84" height="64" />
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li class:list={[item.children && "has-sub"]}>
            <a href={item.href} aria-current={active(item.href) ? "page" : undefined}>
              {item.label}
              {item.children && <Icon name="chevron" size={14} />}
            </a>
            {item.children && (
              <div class="sub">
                <ul>
                  {item.children.map((c) => <li><a href={c.href} aria-current={active(c.href) ? "page" : undefined}>{c.label}</a></li>)}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__cta">
      <a class="hdr__phone" href={business.phoneHref}><Icon name="phone" size={18} /><span>{business.phone}</span></a>
      <a class="btn btn--clover hdr__quote" href="#quote" data-magnetic>Free quote</a>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="mnav" data-burger>
        <span class="sr-only">Open menu</span><Icon name="menu" />
      </button>
    </div>
  </div>

  <div class="mnav" id="mnav" hidden data-mnav>
    <nav aria-label="Mobile">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
            {item.children && <ul>{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>}
          </li>
        ))}
      </ul>
      <div class="mnav__cta">
        <a class="btn btn--clover" href="#quote">Get a free quote</a>
        <a class="btn btn--ghost" href={business.phoneHref}><Icon name="phone" />{business.phone}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .hdr { position: fixed; inset: 0 0 auto; z-index: 50; color: white; transition: background .35s, box-shadow .35s, transform .45s var(--ease-turf); }
  .hdr.is-solid { background: color-mix(in srgb, var(--color-paddock) 94%, transparent); backdrop-filter: blur(10px); box-shadow: 0 1px 0 rgba(255,255,255,.06); }
  .hdr.is-hidden { transform: translateY(-100%); }
  .hdr__in { display: flex; align-items: center; gap: 1.5rem; height: var(--header-h); }
  .hdr__logo { flex: none; }
  .hdr__logo img { height: 52px; width: auto; }
  .hdr__nav { margin-inline: auto; }
  .hdr__nav > ul { display: flex; gap: .25rem; list-style: none; margin: 0; padding: 0; }
  .hdr__nav a { display: inline-flex; align-items: center; gap: .25rem; padding: .55rem .75rem; border-radius: 999px; text-decoration: none; font-weight: 500; font-size: .96rem; white-space: nowrap; transition: background .2s, color .2s; }
  .hdr__nav > ul > li > a:hover, .hdr__nav a[aria-current="page"] { background: rgba(255,255,255,.1); }
  .hdr__nav a[aria-current="page"] { color: var(--color-clover); }
  .has-sub { position: relative; }
  .sub { position: absolute; top: 100%; left: -.5rem; padding-top: .6rem; opacity: 0; visibility: hidden; translate: 0 6px; transition: opacity .2s, translate .25s var(--ease-turf), visibility .2s; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; translate: 0 0; }
  .sub ul { list-style: none; margin: 0; padding: .5rem; min-width: 260px; background: white; color: var(--color-ink); border-radius: var(--radius-md); box-shadow: 0 20px 40px -12px rgba(22,48,31,.35); }
  .sub a { display: block; border-radius: var(--radius-sm); padding: .6rem .8rem; }
  .sub a:hover { background: var(--color-dew); color: var(--color-leaf); }
  .sub a[aria-current="page"] { color: var(--color-leaf); background: var(--color-dew); }
  .hdr__cta { flex: none; display: flex; align-items: center; gap: .75rem; }
  .hdr__phone { display: inline-flex; align-items: center; gap: .45rem; font-weight: 600; text-decoration: none; font-variant-numeric: tabular-nums; }
  .hdr__quote { min-height: 44px; padding: .55rem 1.15rem; }
  .hdr__burger { display: none; background: none; border: 0; color: inherit; padding: .5rem; cursor: pointer; }
  .mnav { background: var(--color-paddock); max-height: calc(100dvh - var(--header-h)); overflow: auto; }
  .mnav nav { padding: 1rem var(--gutter) 2rem; }
  .mnav ul { list-style: none; margin: 0; padding: 0; }
  .mnav > nav > ul > li { border-bottom: 1px solid rgba(255,255,255,.08); }
  .mnav a { display: block; padding: .85rem 0; text-decoration: none; font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; }
  .mnav ul ul { padding: 0 0 .75rem .75rem; }
  .mnav ul ul a { font-family: var(--font-sans); font-weight: 500; font-size: 1rem; padding: .4rem 0; color: rgba(255,255,255,.75); }
  .mnav__cta { display: grid; gap: .75rem; margin-top: 1.5rem; }
  @media (max-width: 1180px) { .hdr__nav { display: none; } .hdr__cta { margin-left: auto; } .hdr__burger { display: inline-flex; } }
  @media (max-width: 560px) { .hdr__phone span { display: none; } .hdr__quote { display: none; } .hdr__logo img { height: 44px; } }
</style>
