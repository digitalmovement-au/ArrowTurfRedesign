---
import { nav, business, img } from "../data/site";
import Icon from "./Icon.astro";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = (Astro.url.pathname.slice(baseUrl.length) || "/").replace(/\/?$/, "/");
const active = (href: string) => {
  const h = href.replace(/\/?$/, "/");
  return h === "/" ? path === "/" : path.startsWith(h);
};
---
<header class="hdr" data-header>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label="Arrow Turf home">
      <img src={img("2024/09/cropped-logo.png")} alt="Arrow Turf" width="84" height="64" />
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li class:list={[item.children && "has-sub"]}>
            <a href={item.href} aria-current={active(item.href) ? "page" : undefined}>
              {item.label}
              {item.children && <Icon name="chevron" size={14} />}
            </a>
            {item.children && (
              <div class="sub">
                <ul>
                  {item.children.map((c) => <li><a href={c.href} aria-current={active(c.href) ? "page" : undefined}>{c.label}</a></li>)}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__cta">
      <a class="hdr__phone" href={business.phoneHref}><Icon name="phone" size={18} /><span>{business.phone}</span></a>
      <a class="btn btn--clover hdr__quote" href="#quote" data-magnetic>Free quote</a>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Open menu" data-burger>
        <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>

</header>

<div class="mnav" id="mnav" hidden data-mnav data-lenis-prevent>
  <nav aria-label="Mobile">
    <ul>
      {nav.map((item, i) => (
        <li style={`--i:${i}`}>
          <a href={item.href} aria-current={active(item.href) ? "page" : undefined}>{item.label}</a>
          {item.children && <ul>{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>}
        </li>
      ))}
    </ul>
    <div class="mnav__cta">
      <a class="btn btn--clover" href="#quote">Get a free quote</a>
      <a class="btn btn--ghost" href={business.phoneHref}><Icon name="phone" />{business.phone}</a>
    </div>
  </nav>
</div>

<style>
  .hdr { position: fixed; inset: 0 0 auto; z-index: 50; color: white; transition: background .35s, box-shadow .35s, transform .45s var(--ease-turf); }
  .hdr.is-solid { background: color-mix(in srgb, var(--color-paddock) 94%, transparent); backdrop-filter: blur(10px); box-shadow: 0 1px 0 rgba(255,255,255,.06); }
  .hdr.is-hidden { transform: translateY(-100%); }
  .hdr__in { display: flex; align-items: center; gap: 1.5rem; height: var(--header-h); }
  .hdr__logo { flex: none; }
  .hdr__logo img { height: 52px; width: auto; }
  .hdr__nav { margin-inline: auto; }
  .hdr__nav > ul { display: flex; gap: .15rem; list-style: none; margin: 0; padding: 0; }
  .hdr__nav a { display: inline-flex; align-items: center; gap: .25rem; padding: .55rem .75rem; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 1.06rem; letter-spacing: .03em; text-transform: uppercase; white-space: nowrap; transition: background .2s, color .2s; }
  .hdr__nav > ul > li > a:hover, .hdr__nav a[aria-current="page"] { background: rgba(255,255,255,.1); }
  .hdr__nav a[aria-current="page"] { color: var(--color-clover); }
  .has-sub { position: relative; }
  .sub { position: absolute; top: 100%; left: -.5rem; padding-top: .6rem; opacity: 0; visibility: hidden; translate: 0 6px; transition: opacity .2s, translate .25s var(--ease-turf), visibility .2s; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; translate: 0 0; }
  .sub ul { list-style: none; margin: 0; padding: .5rem; min-width: 260px; background: white; color: var(--color-ink); border-radius: var(--radius-md); box-shadow: 0 20px 40px -12px rgba(22,48,31,.35); }
  .sub a { display: flex; border-radius: var(--radius-sm); padding: .65rem .85rem; font-size: .95rem; }
  .sub a:hover { background: var(--color-dew); color: var(--color-leaf); }
  .sub a[aria-current="page"] { color: var(--color-leaf); background: var(--color-dew); }
  .hdr__cta { flex: none; display: flex; align-items: center; gap: .75rem; }
  .hdr__phone { display: inline-flex; align-items: center; gap: .45rem; font-weight: 600; text-decoration: none; font-variant-numeric: tabular-nums; }
  .hdr__quote { min-height: 44px; padding: .55rem 1.15rem; }
  .hdr__burger { display: none; place-items: center; width: 48px; height: 48px; margin-right: -.5rem; background: none; border: 0; color: inherit; cursor: pointer; border-radius: 50%; }
  .hdr__burger:hover { background: rgba(255,255,255,.08); }
  .burger { position: relative; display: block; width: 24px; height: 16px; }
  .burger i { position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px; background: currentColor; transition: transform .45s var(--ease-turf), opacity .25s, top .45s var(--ease-turf), width .45s var(--ease-turf); }
  .burger i:nth-child(1) { top: 0; }
  .burger i:nth-child(2) { top: 7px; width: 70%; left: auto; }
  .burger i:nth-child(3) { top: 14px; }
  .hdr__burger[aria-expanded="true"] .burger i:nth-child(1) { top: 7px; transform: rotate(45deg); }
  .hdr__burger[aria-expanded="true"] .burger i:nth-child(2) { opacity: 0; transform: translateX(8px); }
  .hdr__burger[aria-expanded="true"] .burger i:nth-child(3) { top: 7px; transform: rotate(-45deg); }
  .mnav {
    position: fixed; top: var(--header-h); left: 0; right: 0; bottom: 0; z-index: 49;
    background: var(--color-paddock); color: white; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; touch-action: pan-y;
  }
  .mnav.is-open { animation: mnav-in .45s var(--ease-turf) both; }
  .mnav.is-open > nav > ul > li { animation: mnav-item .55s var(--ease-turf) both; animation-delay: calc(var(--i) * 45ms + 80ms); }
  @keyframes mnav-in { from { opacity: 0; clip-path: inset(0 0 100% 0); } to { opacity: 1; clip-path: inset(0 0 0 0); } }
  @keyframes mnav-item { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .mnav a[aria-current="page"] { color: var(--color-clover); }
  .mnav a:not(.btn):hover { color: var(--color-clover); }
  .mnav__cta .btn--ghost { color: white; }
  .mnav nav { padding: 1rem var(--gutter) calc(2.5rem + env(safe-area-inset-bottom)); max-width: 640px; margin-inline: auto; }
  .mnav ul { list-style: none; margin: 0; padding: 0; }
  .mnav > nav > ul > li { border-bottom: 1px solid rgba(255,255,255,.08); }
  .mnav a:not(.btn) { display: block; padding: .85rem 0; text-decoration: none; font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; text-transform: uppercase; letter-spacing: .02em; }
  .mnav ul ul { padding: 0 0 .75rem .75rem; }
  .mnav ul ul a:not(.btn) { font-family: var(--font-sans); font-weight: 500; font-size: 1rem; padding: .4rem 0; color: rgba(255,255,255,.75); }
  .mnav__cta { display: grid; gap: .75rem; margin-top: 1.5rem; }
  @media (max-width: 1380px) { .hdr__nav { display: none; } .hdr__cta { margin-left: auto; } .hdr__burger { display: inline-grid; } }
  @media (min-width: 1381px) { .mnav { display: none !important; } }
  @media (max-width: 560px) { .hdr__phone span { display: none; } .hdr__quote { display: none; } .hdr__logo img { height: 44px; } }
</style>
