---
import Icon from "../Icon.astro";
import { varieties } from "../../data/site";
---
<div class="calc" data-calc>
  <div class="calc__intro">
    <p class="eyebrow">Lawn calculator</p>
    <h2>How much turf do you need?</h2>
    <p class="lead">Measure each part of your lawn in metres. Odd shapes? Break them into rectangles and add each one. We’ll double-check your numbers before you order.</p>
  </div>
  <div class="calc__panel">
    <ol class="calc__rows" data-calc-rows>
      <li class="calc__row" data-calc-row>
        <span class="calc__label">Area 1</span>
        <label><span class="sr-only">Length in metres</span><input type="number" inputmode="decimal" min="0" step="0.1" placeholder="Length" data-l /></label>
        <span aria-hidden="true">×</span>
        <label><span class="sr-only">Width in metres</span><input type="number" inputmode="decimal" min="0" step="0.1" placeholder="Width" data-w /></label>
        <span class="calc__m">m</span>
      </li>
    </ol>
    <button type="button" class="calc__add" data-calc-add><Icon name="plus" size={18} />Add another area</button>
    <label class="calc__opt"><input type="checkbox" checked data-calc-allow /> Add 5% for trimming around edges</label>
    <label class="calc__opt calc__opt--sel">Variety
      <select data-calc-variety><option value="">Not sure yet</option>{varieties.map((v) => <option>{v.name}</option>)}</select>
    </label>
    <div class="calc__out" aria-live="polite">
      <div><span class="calc__big" data-calc-area>0</span><span class="calc__unit">m² to order</span></div>
      <div class="calc__weight"><span data-calc-weight>—</span><span class="calc__unit">approx. weight at 15–20 kg per m²</span></div>
    </div>
    <button type="button" class="btn calc__send" data-calc-send disabled>Add to my quote</button>
  </div>
</div>
<style>
  .calc { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .calc__intro .lead { margin-top: 1.25rem; }
  .calc__panel { background: var(--color-paddock); color: white; border-radius: var(--radius-lg); padding: clamp(1.25rem, 3vw, 2rem); }
  .calc__rows { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .calc__row { display: grid; grid-template-columns: 4.5rem 1fr auto 1fr auto; align-items: center; gap: .5rem; }
  .calc__label { font-size: .85rem; color: rgba(255,255,255,.6); }
  .calc__row input { width: 100%; min-height: 48px; padding: .6rem .8rem; border-radius: var(--radius-sm); border: 1.5px solid rgba(255,255,255,.12); background: rgba(255,255,255,.06); color: white; font: inherit; }
  .calc__row input:focus { outline: none; border-color: var(--color-clover); }
  .calc__m { color: rgba(255,255,255,.6); }
  .calc__add { display: inline-flex; align-items: center; gap: .4rem; margin: .8rem 0 1rem; padding: .4rem 0; background: none; border: 0; color: var(--color-clover); font: inherit; font-weight: 600; cursor: pointer; }
  .calc__opt { display: flex; gap: .6rem; align-items: center; font-size: .95rem; color: rgba(255,255,255,.8); margin-bottom: .6rem; }
  .calc__opt input { accent-color: var(--color-clover); width: 18px; height: 18px; }
  .calc__opt--sel select { flex: 1; min-height: 44px; border-radius: var(--radius-sm); background: rgba(255,255,255,.06); color: white; border: 1.5px solid rgba(255,255,255,.12); padding: .4rem .6rem; font: inherit; }
  .calc__opt--sel option { color: var(--color-ink); }
  .calc__out { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.25rem 0; padding: 1.25rem 0; border-block: 1px solid rgba(255,255,255,.12); }
  .calc__out > div { display: grid; }
  .calc__big { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.6rem, 5vw, 3.6rem); line-height: 1; color: var(--color-clover); font-variant-numeric: tabular-nums; }
  .calc__weight span:first-child { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; line-height: 1.2; }
  .calc__unit { font-size: .85rem; color: rgba(255,255,255,.65); margin-top: .3rem; }
  .calc__send { width: 100%; color: white; }
  .calc__send:disabled { opacity: .55; cursor: not-allowed; }
  @media (max-width: 900px) { .calc { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .calc__row { grid-template-columns: 1fr auto 1fr auto; } .calc__label { grid-column: 1 / -1; } }
</style>
