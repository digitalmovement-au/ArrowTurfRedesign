---
import { img } from "../../data/site";
import SectionHead from "../SectionHead.astro";
import Icon from "../Icon.astro";
interface Props { eyebrow?: string; heading: string; intro?: string; images: { src: string; alt: string }[]; limit?: number; id?: string }
const { eyebrow, heading, intro, images, limit, id } = Astro.props;
---
<div class="gal" data-gallery data-limit={limit}>
  <SectionHead eyebrow={eyebrow} heading={heading} intro={intro} id={id} />
  <ul class="gal__grid">
    {images.map((im, i) => (
      <li class:list={["gal__item", limit && i >= limit && "is-more"]} hidden={limit && i >= limit ? true : undefined}>
        <button type="button" class="gal__btn" data-full={img(im.src)} data-alt={im.alt} aria-label={`View larger: ${im.alt}`}>
          <img src={img(im.src)} alt={im.alt} loading="lazy" decoding="async" />
        </button>
      </li>
    ))}
  </ul>
  {limit && images.length > limit && <div class="gal__more"><button type="button" class="btn btn--ghost" data-gal-more>Load more projects</button></div>}
  <dialog class="lb" data-lightbox aria-label="Project photo">
    <img alt="" data-lb-img />
    <form method="dialog"><button class="lb__x" aria-label="Close"><Icon name="close" /></button></form>
    <button class="lb__nav lb__prev" type="button" aria-label="Previous photo" data-lb-prev><Icon name="arrow" /></button>
    <button class="lb__nav lb__next" type="button" aria-label="Next photo" data-lb-next><Icon name="arrow" /></button>
  </dialog>
</div>
<style>
  .gal__grid { list-style: none; margin: 0; padding: 0; columns: 3 280px; column-gap: 1rem; }
  .gal__item { break-inside: avoid; margin-bottom: 1rem; border-radius: var(--radius-lg); }
  .gal__btn { display: block; width: 100%; padding: 0; border: 0; background: var(--color-dew-2); border-radius: var(--radius-lg); overflow: hidden; cursor: zoom-in; }
  .gal__btn img { width: 100%; height: auto; transition: transform 1s var(--ease-turf); }
  .gal__btn:hover img { transform: scale(1.04); }
  .gal__more { display: flex; justify-content: center; margin-top: 1.5rem; }
  .lb { padding: 0; border: 0; margin: 0; background: transparent; width: 100vw; height: 100dvh; max-width: none; max-height: none; overflow: hidden; }
  .lb[open] { display: grid; place-items: center; }
  .lb form { display: contents; }
  .lb::backdrop { background: rgba(10,25,15,.88); backdrop-filter: blur(6px); }
  .lb img { display: block; width: auto; height: auto; max-width: min(92vw, 1400px); max-height: 86dvh; object-fit: contain; border-radius: var(--radius-md); box-shadow: 0 30px 80px -20px rgba(0,0,0,.6); }
  .lb__x, .lb__nav { position: fixed; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: white; color: var(--color-paddock); border: 0; cursor: pointer; }
  .lb__x { top: 1rem; right: 1rem; }
  .lb__nav { top: 50%; translate: 0 -50%; }
  .lb__prev { left: 1rem; } .lb__prev :global(svg) { transform: rotate(180deg); }
  .lb__next { right: 1rem; }
</style>
