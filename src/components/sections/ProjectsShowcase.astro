---
/**
 * Full-bleed "lawn wall": project photos in columns that drift at different speeds as you scroll,
 * so the gallery feels like walking past a field of finished lawns. Click any photo to open it large.
 */
import { img } from "../../data/site";
import { md } from "../../lib/md";
import Icon from "../Icon.astro";
interface Props { eyebrow?: string; heading: string; intro?: string; images: { src: string; alt: string }[]; id?: string }
const { eyebrow, heading, intro, images, id } = Astro.props;
const COLS = 3;
const cols = Array.from({ length: COLS }, (_, c) => images.filter((_, i) => i % COLS === c));
const speeds = [14, -10, 18];
---
<section class="pw on-dark" id={id} data-gallery aria-labelledby="pw-title">
  <div class="wrap pw__head">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id="pw-title">{heading}</h2>
    {intro && <div class="prose pw__intro" set:html={md(intro)} />}
  </div>

  <div class="pw__window" data-pw-window>
    <div class="pw__cols">
      {cols.map((col, c) => (
        <ul class="pw__col" data-pw-col data-speed={speeds[c]}>
          {col.map((im) => (
            <li>
              <button type="button" class="gal__btn pw__tile" data-full={img(im.src)} data-alt={im.alt} aria-label={`View larger: ${im.alt}`}>
                <img src={img(im.src)} alt={im.alt} loading="lazy" decoding="async" />
                <span class="pw__cap" aria-hidden="true"><Icon name="plus" size={18} />View project</span>
              </button>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <div class="wrap pw__foot">
    <a class="btn btn--clover" href="/turf-projects-sydney/" data-magnetic>See all our projects<Icon name="arrow" /></a>
  </div>

  <dialog class="lb" data-lightbox aria-label="Project photo">
    <img alt="" data-lb-img />
    <form method="dialog"><button class="lb__x" aria-label="Close"><Icon name="close" /></button></form>
    <button class="lb__nav lb__prev" type="button" aria-label="Previous photo" data-lb-prev><Icon name="arrow" /></button>
    <button class="lb__nav lb__next" type="button" aria-label="Next photo" data-lb-next><Icon name="arrow" /></button>
  </dialog>
</section>

<style>
  .pw { background: var(--color-paddock); color: white; padding: clamp(4.5rem, 9vw, 7.5rem) 0 clamp(3.5rem, 7vw, 5.5rem); overflow: hidden; }
  .pw__head { text-align: center; max-width: 52rem; margin-inline: auto; }
  .pw__head .eyebrow { justify-content: center; }
  .pw__head h2 { color: white; font-size: clamp(2.6rem, 6vw, 5rem); letter-spacing: -.035em; }
  .pw__intro { margin: 1.5rem auto 0; text-align: center; }
  .pw__window {
    position: relative; margin-top: clamp(2.5rem, 5vw, 4rem); height: clamp(620px, 105vh, 1040px); overflow: hidden;
    mask-image: linear-gradient(180deg, transparent 0, #000 12%, #000 88%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 12%, #000 88%, transparent 100%);
  }
  .pw__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(.75rem, 1.5vw, 1.25rem); width: min(100% - var(--gutter) * 2, 1240px); margin-inline: auto; }
  .pw__col { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(.75rem, 1.5vw, 1.25rem); align-content: start; will-change: transform; }
  .pw__col:nth-child(2) { margin-top: 18%; }
  .pw__tile { position: relative; display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in; border-radius: var(--radius-lg); overflow: hidden; background: var(--color-paddock-2); }
  .pw__tile img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; transform: scale(1.02); transition: transform 1.1s var(--ease-turf), filter .6s; }
  .pw__tile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(16,36,23,.75)); opacity: 0; transition: opacity .5s; }
  .pw__cap { position: absolute; left: 1rem; bottom: 1rem; z-index: 1; display: inline-flex; align-items: center; gap: .4rem; padding: .45rem .85rem; border-radius: 999px; background: var(--color-clover); color: var(--color-paddock); font-weight: 600; font-size: .9rem; opacity: 0; transform: translateY(10px); transition: opacity .4s, transform .5s var(--ease-turf); }
  .pw__tile:hover img, .pw__tile:focus-visible img { transform: scale(1.08); }
  .pw__tile:hover::after, .pw__tile:focus-visible::after, .pw__tile:hover .pw__cap, .pw__tile:focus-visible .pw__cap { opacity: 1; transform: none; }
  .pw__tile:focus-visible { outline-offset: -4px; }
  .pw__foot { display: flex; justify-content: center; margin-top: 2.5rem; }

  .lb { padding: 0; border: 0; background: transparent; max-width: min(94vw, 1200px); max-height: 92vh; overflow: visible; }
  .lb::backdrop { background: rgba(10,25,15,.9); backdrop-filter: blur(6px); }
  .lb img { max-height: 88vh; width: auto; margin: auto; border-radius: var(--radius-md); }
  .lb__x, .lb__nav { position: fixed; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: white; color: var(--color-paddock); border: 0; cursor: pointer; }
  .lb__x { top: 1rem; right: 1rem; }
  .lb__nav { top: 50%; translate: 0 -50%; }
  .lb__prev { left: 1rem; } .lb__prev :global(svg) { transform: rotate(180deg); }
  .lb__next { right: 1rem; }

  @media (max-width: 700px) {
    .pw__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pw__col:nth-child(3) { display: none; }
    .pw__window { height: clamp(560px, 95vh, 820px); }
  }
  /* No-motion: show a calm, complete grid instead of a cropped window */
  :global(html:not(.js-motion)) .pw__window { height: auto; mask-image: none; -webkit-mask-image: none; }
  :global(html:not(.js-motion)) .pw__col:nth-child(2) { margin-top: 0; }
  :global(html:not(.js-motion)) .pw__col:nth-child(3) { display: grid; }
</style>
