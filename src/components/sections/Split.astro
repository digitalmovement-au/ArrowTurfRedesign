---
import { md } from "../../lib/md";
import Roll from "../Roll.astro";
import Icon from "../Icon.astro";
interface Props { eyebrow?: string; heading: string; body: string; image?: string; imageAlt?: string; reverse?: boolean; cta?: boolean; dark?: boolean }
const { eyebrow, heading, body, image, imageAlt = "", reverse = false, cta = false } = Astro.props;
---
<div class:list={["split", reverse && "split--rev", !image && "split--solo"]}>
  <div class="split__copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{heading}</h2>
    <div class="prose split__prose" set:html={md(body)} />
    {cta && <a class="btn split__cta" href="#quote" data-magnetic>Get a free quote<Icon name="arrow" /></a>}
  </div>
  {image && (
    <div class="split__media">
      <Roll src={image} alt={imageAlt} class="split__img" />
    </div>
  )}
</div>

<style>
  .split { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  .split--rev .split__media { order: -1; }
  .split--solo { grid-template-columns: 1fr; }
  .split__prose { margin-top: 1.5rem; }
  .split__cta { margin-top: 2rem; }
  .split__media { position: sticky; top: calc(var(--header-h) + 2rem); }
  :global(.split__img) { aspect-ratio: 4 / 5; }
  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; }
    .split--rev .split__media { order: 0; }
    .split__media { position: relative; top: 0; }
    :global(.split__img) { aspect-ratio: 4 / 3; }
  }
</style>
