---
/** Desktop: a row of tall panels — the hovered/focused one widens like a roll being pulled open. Mobile: swipe row. */
import { varieties, img } from "../../data/site";
import SectionHead from "../SectionHead.astro";
import Icon from "../Icon.astro";
interface Props { eyebrow?: string; heading: string; intro?: string; exclude?: string; only?: string[]; center?: boolean }
const { eyebrow, heading, intro, exclude, only, center = false } = Astro.props;
const list = varieties.filter((v) => v.slug !== exclude && (!only || only.includes(v.slug)));
---
<div class="vc">
  <SectionHead eyebrow={eyebrow} heading={heading} intro={intro} center={center} />
  <ul class="vc__row" style={`--n:${list.length}`} data-variety-row>
    {list.map((v, i) => (
      <li class:list={["vc__card", i === 0 && "is-open"]} data-roll data-roll-delay={i * 0.12}>
        <a href={v.href} class="vc__link">
          <img data-roll-media src={img(v.image)} alt={`${v.name} turf`} loading="lazy" decoding="async" />
          <span class="vc__shade" aria-hidden="true"></span>
          <span class="vc__tags">{v.tags}</span>
          <span class="vc__body">
            <span class="vc__name">{v.name}</span>
            <span class="vc__blurb">{v.blurb}</span>
            <span class="vc__more">View {v.short}<Icon name="arrow" size={18} /></span>
          </span>
        </a>
        <span class="roll__cyl" aria-hidden="true"></span>
      </li>
    ))}
  </ul>
</div>

<style>
  .vc__row { list-style: none; margin: 0; padding: 0; display: flex; gap: .75rem; height: clamp(460px, 62vh, 600px); }
  .vc__card { position: relative; flex: 1 1 0; min-width: 0; border-radius: var(--radius-lg); overflow: hidden; transition: flex-grow .7s var(--ease-turf); }
  .vc__card.is-open { flex-grow: 3.2; }
  .vc__link { position: absolute; inset: 0; color: white; text-decoration: none; display: block; }
  .vc__link img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 1.2s var(--ease-turf); }
  .vc__card.is-open img { transform: scale(1); }
  .vc__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16,36,23,.55) 0%, rgba(16,36,23,0) 22%, rgba(16,36,23,.1) 45%, rgba(16,36,23,.9) 100%); }
  .vc__tags { position: absolute; top: 1.1rem; left: 1.1rem; right: 1.1rem; font-size: .85rem; font-weight: 600; color: var(--color-clover); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vc__body { position: absolute; left: 0; right: 0; bottom: 0; padding: 1.4rem; display: grid; gap: .6rem; }
  .vc__name { font-family: var(--font-display); font-weight: 800; letter-spacing: -.02em; font-size: clamp(1.3rem, 2vw, 2rem); line-height: 1.02; }
  .vc__card:not(.is-open) .vc__name { font-size: 1.2rem; }
  .vc__card:not(.is-open) .vc__tags { opacity: 0; }
  .vc__tags { transition: opacity .4s; }
  .vc__blurb, .vc__more { max-height: 0; opacity: 0; overflow: hidden; transition: max-height .6s var(--ease-turf), opacity .4s; }
  .vc__blurb { font-size: .97rem; color: rgba(255,255,255,.85); max-width: 46ch; }
  .vc__more { display: inline-flex; align-items: center; gap: .4rem; font-weight: 600; color: var(--color-clover); }
  .vc__card.is-open .vc__blurb { max-height: 12rem; opacity: 1; transition-delay: .15s; }
  .vc__card.is-open .vc__more { max-height: 2rem; opacity: 1; transition-delay: .25s; }
  .vc__link:focus-visible { outline-offset: -4px; }
  @media (max-width: 900px) {
    .vc__row { height: auto; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .5rem; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scrollbar-width: none; }
    .vc__card, .vc__card.is-open { flex: 0 0 min(82vw, 360px); height: 480px; scroll-snap-align: start; }
    .vc__card .vc__blurb, .vc__card .vc__more { max-height: 12rem; opacity: 1; }
    .vc__card:not(.is-open) .vc__name { font-size: 1.6rem; }
    .vc__link img { transform: none; }
  }
</style>
