---
import { mdi, md } from "../../lib/md";
import Icon from "../Icon.astro";
import Roll from "../Roll.astro";
import SectionHead from "../SectionHead.astro";
interface Props { eyebrow?: string; heading: string; intro?: string; items: { title: string; body: string; icon?: string }[]; image?: string }
const { eyebrow, heading, intro, items, image } = Astro.props;
---
<div class:list={["feat", image && "feat--img"]}>
  <div class="feat__head">
    <SectionHead eyebrow={eyebrow} heading={heading} intro={intro} />
    {image && <Roll src={image} alt="" class="feat__img" />}
  </div>
  <ul class="feat__list">
    {items.map((it) => (
      <li class="feat__item">
        <span class="feat__ico"><Icon name={it.icon ?? "leaf"} /></span>
        <div>
          <h3 set:html={mdi(it.title)} />
          <div class="prose" set:html={md(it.body)} />
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  .feat { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .feat--img { grid-template-columns: .9fr 1.1fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .feat__head { position: sticky; top: calc(var(--header-h) + 2rem); }
  :global(.feat__img) { aspect-ratio: 5 / 4; margin-top: 1rem; }
  .feat__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 0 3rem; border-top: 1px solid color-mix(in srgb, var(--color-paddock) 14%, transparent); }
  .feat--img .feat__list { grid-template-columns: 1fr; }
  .feat__item { display: grid; grid-template-columns: auto 1fr; gap: 1.1rem; padding: 1.75rem 0; border-bottom: 1px solid color-mix(in srgb, var(--color-paddock) 14%, transparent); }
  .feat:not(.feat--img) .feat__item { padding-right: 1.5rem; }
  .feat__ico { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: color-mix(in srgb, var(--color-leaf) 12%, transparent); color: var(--color-leaf); }
  .feat__item h3 { font-size: 1.3rem; margin-bottom: .5rem; }
  :global(.section--dark) .feat__list, :global(.section--dark) .feat__item { border-color: rgba(255,255,255,.12); }
  :global(.section--dark) .feat__ico { background: rgba(184,216,107,.14); color: var(--color-clover); }
  @media (max-width: 900px) { .feat--img { grid-template-columns: 1fr; } .feat__head { position: relative; top: 0; } }
</style>
