---
import { md } from "../../lib/md";
import { img } from "../../data/site";
import Icon from "../Icon.astro";
import SectionHead from "../SectionHead.astro";
interface Props { eyebrow?: string; heading: string; intro?: string; items: { icon: string; title: string; body: string; href: string; link: string; image: string }[] }
const { eyebrow, heading, intro, items } = Astro.props;
---
<div class="pt">
  <SectionHead eyebrow={eyebrow} heading={heading} intro={intro} center />
  <ul class="pt__grid">
    {items.map((it) => (
      <li>
        <a class="pt__card" href={it.href}>
          <img src={img(it.image)} alt="" loading="lazy" decoding="async" />
          <span class="pt__shade" aria-hidden="true"></span>
          <span class="pt__body">
            <span class="pt__ico"><Icon name={it.icon} size={24} /></span>
            <span class="pt__t">{it.title}</span>
            <span class="pt__b" set:html={md(it.body)} />
            <span class="pt__link">{it.link}<Icon name="arrow" size={18} /></span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>
<style>
  .pt__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .pt__card { position: relative; display: block; height: clamp(420px, 52vh, 520px); border-radius: var(--radius-lg); overflow: hidden; color: white; text-decoration: none; isolation: isolate; }
  .pt__card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.2s var(--ease-turf); }
  .pt__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(16,36,23,.1) 0%, rgba(16,36,23,.35) 40%, rgba(16,36,23,.95) 100%); transition: background .5s; }
  .pt__card:hover img { transform: scale(1.07); }
  .pt__card:hover .pt__shade { background: linear-gradient(180deg, rgba(16,36,23,.3) 0%, rgba(16,36,23,.6) 35%, rgba(16,36,23,.97) 100%); }
  .pt__body { position: absolute; inset: auto 0 0 0; display: grid; gap: .6rem; padding: 1.5rem; }
  .pt__ico { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--color-clover); color: var(--color-paddock); }
  .pt__t { font-family: var(--font-display); font-weight: 800; font-size: 1.45rem; letter-spacing: -.02em; line-height: 1.05; text-transform: capitalize; }
  .pt__b { font-size: .95rem; color: rgba(255,255,255,.82); max-height: 0; opacity: 0; overflow: hidden; transition: max-height .6s var(--ease-turf), opacity .4s; }
  .pt__b :global(p) { margin: 0; }
  .pt__card:hover .pt__b, .pt__card:focus-visible .pt__b { max-height: 10rem; opacity: 1; }
  .pt__link { display: inline-flex; align-items: center; gap: .4rem; font-weight: 600; color: var(--color-clover); text-transform: capitalize; }
  @media (max-width: 1100px) { .pt__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (hover: none), (max-width: 720px) { .pt__b { max-height: none; opacity: 1; } }
  @media (max-width: 720px) {
    .pt__grid { grid-template-columns: 1fr; }
    .pt__card { height: 400px; }
    .pt__body { justify-items: center; text-align: center; }
  }
</style>
