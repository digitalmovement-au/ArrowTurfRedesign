---
import { img } from "../../data/site";
import SectionHead from "../SectionHead.astro";
interface Props { eyebrow?: string; heading: string; src: string; poster?: string }
const { eyebrow, heading, src, poster } = Astro.props;
---
<div>
  <SectionHead eyebrow={eyebrow} heading={heading} />
  <div class="vid roll" data-roll>
    <video src={img(src)} poster={poster ? img(poster) : undefined} controls playsinline muted preload="none"></video>
    <span class="roll__cyl" aria-hidden="true"></span>
  </div>
</div>
<style>
  .vid { aspect-ratio: 16 / 9; background: var(--color-paddock); }
  .vid video { width: 100%; height: 100%; object-fit: cover; }
</style>
