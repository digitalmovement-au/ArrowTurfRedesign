# Where WordPress media is served from. Leave unset to hotlink the live site during the build-out.
# After running `npm run fetch-images`, set to /uploads to serve local copies.
# PUBLIC_UPLOADS_BASE=/uploads

# Optional: POST quote enquiries to a form service (Formspree, Basin, your own API).
# Leave unset to use Netlify Forms (works automatically when deployed on Netlify).
# PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxx
